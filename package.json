{
	"name": "central-roleplay-bot",
	"version": "1.0.0",
	"description": "Central Roleplay Discord bot — FiveM tickets, moderation, and server status",
	"main": "dist/index.js",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"dev": "tsx watch src/index.ts",
		"deploy": "tsx src/deploy-commands.ts",
		"deploy:build": "tsc && node dist/deploy-commands.js",
		"format": "prettier . --write",
		"format:check": "prettier . --check"
	},
	"dependencies": {
		"better-sqlite3": "^12.11.1",
		"discord-html-transcripts": "3.2.0",
		"discord.js": "^14.26.4",
		"dotenv": "^16.6.1",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^22.20.0",
		"prettier": "^3.9.3",
		"tsx": "^4.22.4",
		"typescript": "^5.9.3"
	}
}
